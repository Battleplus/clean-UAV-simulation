# ROS / colcon generated files
**/build/
**/build_ros2/
**/install/
**/install_ros2/
**/log/
**/log_ros2/

# Python caches
**/__pycache__/
*.py[cod]
.pytest_cache/

# IDE and OS files
.vs/
.vscode/
.idea/
Thumbs.db
.DS_Store

# Compiled helper outputs
**/bin/
**/obj/

# Local dependency caches and scratch extraction
drone_sim_ws/.deps/
_wsl_extract/
.workbuddy/

# Large upstream archive; PX4 is maintained separately
PX4-main.tar.gz

# Runtime simulator logs
*.ulg

# Iterative runtime evidence is summarized in Markdown/JSON.  Curated logs
# may still be added explicitly with `git add -f` when they prove an
# acceptance result.
drone_sim_ws/analysis/*.log
drone_sim_ws/analysis/*.status
drone_sim_ws/analysis/*.exit

# Nested flight-test output. Keep compact curated Markdown / JSON reports in
# Git, but leave raw high-rate telemetry and process artifacts local.
drone_sim_ws/analysis/**/*.log
drone_sim_ws/analysis/**/*.jsonl
drone_sim_ws/analysis/**/*.partial.jsonl
drone_sim_ws/analysis/**/*.pid

# Local media used while reviewing simulator behaviour.
tmp_video_review/
