 }
 
 void GZBridge::airspeedCallback(const gz::msgs::AirSpeed &msg)
@@ -431,7 +434,23 @@ void GZBridge::airspeedCallback(const gz::msgs::AirSpeed &msg)
 
 void GZBridge::imuCallback(const gz::msgs::IMU &msg)
 {
-	const uint64_t timestamp = hrt_absolute_time();
+	// Sensor callbacks may be delivered in a batch after the Gazebo clock has
+	// already advanced.  hrt_absolute_time() then assigns identical sample
+	// times to distinct 250 Hz messages and PX4 rejects the duplicates.  The
+	// Gazebo protobuf header carries the actual simulation sample time.
+	const uint64_t source_timestamp = static_cast<uint64_t>(msg.header().stamp().sec()) * 1000000ULL
+					  + static_cast<uint64_t>(msg.header().stamp().nsec()) / 1000ULL;
+	// Gazebo can dispatch a sensor header slightly ahead of the clock sample
+	// currently visible to PX4.  Passing that future sample time makes
+	// VehicleIMU reject it because publication timestamp < timestamp_sample,
+	// which in turn destabilizes EKF vertical velocity during startup.
+	const uint64_t timestamp = math::min(source_timestamp, uint64_t{hrt_absolute_time()});
+
+	if (timestamp <= _imu_timestamp_sample_last) {
+		return;
+	}
+
+	_imu_timestamp_sample_last = timestamp;
 
 	// FLU -> FRD
 	static const auto q_FLU_to_FRD = gz::math::Quaterniond(0, 1, 0, 0);
