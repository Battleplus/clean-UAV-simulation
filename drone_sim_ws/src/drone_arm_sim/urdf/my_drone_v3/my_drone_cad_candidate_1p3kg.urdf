  <gazebo reference="base_link">
    <sensor name="air_pressure_sensor" type="air_pressure">
      <gz_frame_id>base_link</gz_frame_id>
      <always_on>1</always_on>
      <update_rate>50</update_rate>
      <topic>/my_drone/raw/air_pressure</topic>
      <air_pressure>
        <pressure>
          <noise type="gaussian">
            <mean>0</mean>
            <stddev>0.2</stddev>
          </noise>
        </pressure>
      </air_pressure>
    </sensor>
    <sensor name="magnetometer_sensor" type="magnetometer">
      <gz_frame_id>base_link</gz_frame_id>
      <always_on>1</always_on>
      <update_rate>100</update_rate>
      <topic>/my_drone/raw/magnetometer</topic>
      <magnetometer>
        <x>
          <noise type="gaussian">
            <stddev>0.0001</stddev>
          </noise>
        </x>
        <y>
          <noise type="gaussian">
            <stddev>0.0001</stddev>
          </noise>
        </y>
        <z>
          <noise type="gaussian">
            <stddev>0.0001</stddev>
          </noise>
        </z>
      </magnetometer>
    </sensor>
    <sensor name="imu_sensor" type="imu">
      <gz_frame_id>base_link</gz_frame_id>
      <always_on>1</always_on>
      <update_rate>250</update_rate>
      <topic>/my_drone/raw/imu</topic>
      <imu>
        <angular_velocity>
          <x>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.0008726646</stddev>
            </noise>
          </x>
          <y>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.0008726646</stddev>
            </noise>
          </y>
          <z>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.0008726646</stddev>
            </noise>
          </z>
        </angular_velocity>
        <linear_acceleration>
          <x>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.00637</stddev>
            </noise>
          </x>
          <y>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.00637</stddev>
            </noise>
          </y>
          <z>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.00686</stddev>
            </noise>
          </z>
        </linear_acceleration>
      </imu>
    </sensor>
    <sensor name="navsat_sensor" type="navsat">
      <gz_frame_id>base_link</gz_frame_id>
      <always_on>1</always_on>
      <update_rate>30</update_rate>
      <topic>/my_drone/raw/navsat</topic>
    </sensor>
  </gazebo>
  <ros2_control name="GazeboSimSystem" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>
    <joint name="shoulder_pan">
      <command_interface name="position">
        <param name="min">-1.91986</param>
        <param name="max">1.91986</param>
      </command_interface>
      <state_interface name="position">
        <param name="initial_value">0</param>
      </state_interface>
      <state_interface name="velocity" />
    </joint>
    <joint name="shoulder_lift">
      <command_interface name="position">
        <param name="min">-1.74533</param>
        <param name="max">1.74533</param>
      </command_interface>
      <state_interface name="position">
        <param name="initial_value">1.44545157679</param>
      </state_interface>
      <state_interface name="velocity" />
    </joint>
    <joint name="elbow_flex">
      <command_interface name="position">
        <param name="min">-1.69</param>
        <param name="max">1.69</param>
      </command_interface>
      <state_interface name="position">
        <param name="initial_value">-1.40681746</param>
      </state_interface>
      <state_interface name="velocity" />
    </joint>
    <joint name="wrist_flex">
      <command_interface name="position">
        <param name="min">-1.65806</param>
        <param name="max">1.65806</param>
      </command_interface>
      <state_interface name="position">
        <param name="initial_value">-0.012711265</param>
      </state_interface>
      <state_interface name="velocity" />
    </joint>
    <joint name="wrist_roll">
      <command_interface name="position">
        <param name="min">-2.74385</param>
        <param name="max">2.84121</param>
      </command_interface>
      <state_interface name="position">
        <param name="initial_value">-0.785398163397</param>
      </state_interface>
      <state_interface name="velocity" />
    </joint>
    <joint name="gripper">
      <command_interface name="position">
        <param name="min">-0.174533</param>
        <param name="max">1.74533</param>
      </command_interface>
      <state_interface name="position">
        <param name="initial_value">0</param>
      </state_interface>
      <state_interface name="velocity" />
    </joint>
  </ros2_control>
  <gazebo>
    <plugin filename="libgz_ros2_control-system.so" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(find drone_arm_sim)/config/so101_ros2_control.yaml</parameters>
      <hold_joints>true</hold_joints>
      <position_proportional_gain>0.5</position_proportional_gain>
    </plugin>
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <joint_name>shoulder_pan</joint_name>
      <joint_name>shoulder_lift</joint_name>
      <joint_name>elbow_flex</joint_name>
      <joint_name>wrist_flex</joint_name>
      <joint_name>wrist_roll</joint_name>
      <joint_name>gripper</joint_name>
    </plugin>
    <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
      <dimensions>3</dimensions>
      <odom_publish_frequency>250</odom_publish_frequency>
      <odom_topic>/model/my_drone/odometry</odom_topic>
      <odom_frame>world</odom_frame>
      <robot_base_frame>base_link</robot_base_frame>
    </plugin>
  </gazebo>
</robot>