<?xml version="1.0"?>
<sdf version="1.9">
  <world name="flight_world">
    <gravity>0 0 -9.81</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type="adiabatic"/>
    <physics name="flight_step" type="ignored">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-contact-system"
            name="gz::sim::systems::Contact"/>
    <plugin filename="gz-sim-apply-link-wrench-system"
            name="gz::sim::systems::ApplyLinkWrench"/>
    <plugin filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system"
            name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-magnetometer-system"
            name="gz::sim::systems::Magnetometer"/>
    <plugin filename="gz-sim-air-pressure-system"
            name="gz::sim::systems::AirPressure"/>
    <plugin filename="gz-sim-navsat-system"
            name="gz::sim::systems::NavSat"/>
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>47.397971057728974</latitude_deg>
      <longitude_deg>8.546163739800000</longitude_deg>
      <elevation>0</elevation>
      <heading_deg>0</heading_deg>
    </spherical_coordinates>
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane><normal>0 0 1</normal><size>100 100</size></plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane><normal>0 0 1</normal><size>100 100</size></plane>
          </geometry>
          <material>
            <ambient>0.65 0.65 0.65 1</ambient>
            <diffuse>0.65 0.65 0.65 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <!-- Bring-up landing supports.  The formal CAD retracted gripper extends
         below the body collision; these four small static feet keep the
         spawned aircraft level until PX4 takes off, without altering the CAD
         model or the in-flight free-body dynamics. -->
    <model name="my_drone_bringup_landing_support">
      <static>true</static>
      <link name="front_left_support">
        <pose>0.17 0.17 0.4085 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>0.05 0.05 0.817</size></box></geometry>
          <!-- The supports are a bring-up fixture, not landing gear.  Low
               tangential friction prevents a canted rotor takeoff from
               unloading one corner first and storing a lateral impulse. -->
          <surface><friction><ode><mu>0.02</mu><mu2>0.02</mu2></ode></friction></surface>
        </collision>
      </link>
      <link name="front_right_support">
        <pose>0.17 -0.17 0.4085 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>0.05 0.05 0.817</size></box></geometry>
          <surface><friction><ode><mu>0.02</mu><mu2>0.02</mu2></ode></friction></surface>
        </collision>
      </link>
      <link name="rear_left_support">
        <pose>-0.17 0.17 0.4085 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>0.05 0.05 0.817</size></box></geometry>
          <surface><friction><ode><mu>0.02</mu><mu2>0.02</mu2></ode></friction></surface>
        </collision>
      </link>
      <link name="rear_right_support">
        <pose>-0.17 -0.17 0.4085 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>0.05 0.05 0.817</size></box></geometry>
          <surface><friction><ode><mu>0.02</mu><mu2>0.02</mu2></ode></friction></surface>
        </collision>
      </link>
    </model>
  </world>
</sdf>
