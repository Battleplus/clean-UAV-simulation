<?xml version="1.0"?>
<sdf version="1.10">
  <model name="my_drone_bringup_landing_support">
    <static>true</static>
    <!-- Restore four-point landing pads 20 mm below the startup fixture.
         Keeping the landing surface exactly at the estimator's initial
         height can stop AUTO LAND before it is still commanding descent, so
         PX4 never observes ground_contact and never auto-disarms.  The small
         offset preserves the stable four-pad geometry while ensuring contact
         occurs during an active descent.  Moderate friction prevents the
         vehicle sliding off these small pads during PX4's touchdown yaw
         transient. -->
    <link name="front_left_support">
      <pose>0.17 0.17 0.3985 0 0 0</pose>
      <collision name="collision">
        <geometry><box><size>0.05 0.05 0.797</size></box></geometry>
        <surface><friction><ode><mu>0.4</mu><mu2>0.4</mu2></ode></friction></surface>
      </collision>
    </link>
    <link name="front_right_support">
      <pose>0.17 -0.17 0.3985 0 0 0</pose>
      <collision name="collision">
        <geometry><box><size>0.05 0.05 0.797</size></box></geometry>
        <surface><friction><ode><mu>0.4</mu><mu2>0.4</mu2></ode></friction></surface>
      </collision>
    </link>
    <link name="rear_left_support">
      <pose>-0.17 0.17 0.3985 0 0 0</pose>
      <collision name="collision">
        <geometry><box><size>0.05 0.05 0.797</size></box></geometry>
        <surface><friction><ode><mu>0.4</mu><mu2>0.4</mu2></ode></friction></surface>
      </collision>
    </link>
    <link name="rear_right_support">
      <pose>-0.17 -0.17 0.3985 0 0 0</pose>
      <collision name="collision">
        <geometry><box><size>0.05 0.05 0.797</size></box></geometry>
        <surface><friction><ode><mu>0.4</mu><mu2>0.4</mu2></ode></friction></surface>
      </collision>
    </link>
  </model>
</sdf>
